# Third-party interpreter and extension sources: 272 MB, cloned by run.sh sources.
cinderx-workshop/

# Built interpreters and their prefixes.
build/
*.o
*.so
*.dylib
*.a

# Virtualenvs. uv.lock is committed; the tree it expands into is not.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.uv-cache/

# Bulky run artefacts: per-worker sampler streams and service stdout.
service/load/results/**/sampler/
service/load/results/**/service.log
*.jsonl

# Measurement outputs are kept: pyperf sidecars and ladder verdicts are the
# evidence the article cites. Only the raw streams above are dropped.
!results/**/*.json
!service/load/results/**/*.json

# Database state: the fixture is regenerated by the seed, never restored.
pgdata/
*.sql.gz

# Editors, OS, tooling.
.DS_Store
.idea/
.vscode/
*.swp
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Secrets: the DSN lives in the environment, never in the tree.
.env
.env.*
!.env.example
